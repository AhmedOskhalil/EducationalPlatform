@page "/courses"
@rendermode InteractiveServer
@using EducationalPlatform.Application.DTOs
@using EducationalPlatform.Application.Features.Courses.Commands.DeleteCourse
@using EducationalPlatform.Application.Features.Courses.Queries.GetCourses
@using EducationalPlatform.Domain.Entities
@using MediatR
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IMediator Mediator

<h3>Courses</h3>


@if (isLoading)
{
    <p>Loading courses...</p>
}
else if (courses.Count == 0)
{
    <p>No courses found.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Slug</th>
                <th>Price</th>
                <th>Status</th>
                <th>Difficulty</th>
                <th>Delivery Type</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var course in courses)
            {
                <tr>
                    <td>@course.Title</td>
                    <td>@course.Slug</td>
                    <td>@course.Price</td>
                    <td>@course.Status</td>
                    <td>@course.Difficulty</td>
                    <td>@course.DeliveryType</td>
                    <td>
                        <a href="/courses/edit/@course.Id">
                            Edit
                        </a>

                        <button @onclick="() => DeleteCourse(course.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<CourseDto> courses = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            courses = await Mediator.Send(new GetCoursesQuery());
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteCourse(int courseId)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this course?");

        if (!confirmed)
            return;

        var result = await Mediator.Send(
            new DeleteCourseCommand(courseId));

        if (result.Succeeded)
        {
            courses = await Mediator.Send(new GetCoursesQuery());
        }
    }
}